PORT=3002
# Public URL of this server. Tokens must be minted with audience "<BASE_URL>/mcp".
BASE_URL=http://localhost:3002

# Production: your identity provider. Leave both empty to use the local dev signing key.
OAUTH_ISSUER=
OAUTH_JWKS_URL=

# Optional append-only JSONL audit log.
AUDIT_LOG_PATH=

# Only for `npm run eval` against Claude. Without it the eval uses a scripted agent.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
